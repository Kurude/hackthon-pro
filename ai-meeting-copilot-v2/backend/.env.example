# Rename this file to .env and fill in your keys

# Get a FREE Groq API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any long random string (used to sign JWT auth tokens)
SECRET_KEY=change_this_to_a_long_random_secret_string

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
